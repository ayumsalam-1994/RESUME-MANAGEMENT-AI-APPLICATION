# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4200

# Database Connection
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/resume_ai

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# AI (Google Gemini)
# Get your API key at: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Email (Resend) - used for password reset and payment receipts
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here
# Until you verify your own domain in Resend, onboarding@resend.dev only delivers to your own Resend account email
EMAIL_FROM=RoleFit <onboarding@resend.dev>

# Payments (ToyyibPay)
# Sign up at: https://toyyibpay.com, then get your User Secret Key under Profile settings
TOYYIBPAY_USER_SECRET_KEY=your-toyyibpay-user-secret-key
# Create a Category/Service in your ToyyibPay dashboard and get the Category Code
TOYYIBPAY_CATEGORY_CODE=your-toyyibpay-category-code
# Public URL your backend is accessible at — ToyyibPay posts the payment callback here
# For local testing, use a tunnel like: npx localtunnel --port 3000
TOYYIBPAY_CALLBACK_URL=https://your-domain.com/api/payments/callback
# Use sandbox for testing: https://dev.toyyibpay.com
TOYYIBPAY_BASE_URL=https://toyyibpay.com

# Subscription settings
SUBSCRIPTION_PRICE_RM=29
AI_MONTHLY_QUOTA=30
